{
  "name": "core-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bash ../dev.sh",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:dev:log": "mkdir -p logs && NODE_ENV=development nest start --watch 2>&1 | tee logs/app.log",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/entry-points/http/api-v1/main",
    "start:dev:v2": "NODE_ENV=development PORT=3002 nest start --watch -c nest-cli.v2.json",
    "start:prod:v2": "node dist/entry-points/http/api-v2/main",
    "start:dev:bot": "NODE_ENV=development ts-node -r tsconfig-paths/register src/entry-points/bot-worker/main.ts",
    "start:prod:bot": "node dist/entry-points/bot-worker/main",
    "bot:keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "bot:smoke": "ts-node -r tsconfig-paths/register scripts/hostbot-smoke.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:down:clean": "docker compose -f docker-compose.dev.yml down -v",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:dump": "mkdir -p scripts/initdb && docker exec dota-core-be-postgres pg_dump -U dota --no-owner --no-acl --clean --if-exists dota_dev > scripts/initdb/seed.sql && echo 'Snapshot saved to scripts/initdb/seed.sql'",
    "db:restore": "docker exec -i dota-core-be-postgres psql -U dota -d dota_dev < scripts/initdb/seed.sql && echo 'Restore complete'",
    "db:seed": "NODE_ENV=development ts-node -r tsconfig-paths/register scripts/seed.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate:v2": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "migration:run:v2": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert:v2": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/data-source.js",
    "migration:run:v2:prod": "typeorm migration:run -d dist/db/data-source.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "discord-interactions": "^4.4.0",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "protobufjs": "^7.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.1",
    "steam-user": "^5.3.0",
    "typeorm": "^0.3.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
