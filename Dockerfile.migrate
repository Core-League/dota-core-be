# syntax=docker/dockerfile:1
#
# Migration-runner image (the `migrate` service in docker-compose.yml).
# One-shot: runs v1 + v2 migrations via typeorm-ts-node-commonjs, then exits.
# Needs dev deps (ts-node) + src; no `npm run build` — migrations run off src/.
# Kept separate from the app Dockerfile so the app image stays prod-only/lean.

FROM node:24-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
CMD ["sh", "-c", "npm run migration:run && npm run migration:run:v2"]
