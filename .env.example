NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Discord OAuth — redirect must match Developer Portal exactly (scheme + host + path)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
DISCORD_SCOPES=identify
# Бот і гільдія для синхронізації ролей (ник у гільдії, verified/captain/admin у Discord)
DISCORD_BOT_TOKEN=
DISCORD_SYNC_GUILD_ID=
# Ролі в Discord (ID з сервера); якщо порожньо — відповідна синхронізація пропускається
DISCORD_VERIFIED_ROLE_ID=
DISCORD_ROLE_ID_CAPTAIN=
DISCORD_ROLE_ID_ADMIN=

# Steam OpenID — callback must be the public URL of GET /auth/steam/callback on this API (not the SPA)
STEAM_CALLBACK_URI=http://127.0.0.1:3000/auth/steam/callback
STEAM_FRONTEND_REDIRECT=http://localhost:5173/me

# App JWT (HS256). Generate: openssl rand -base64 32
JWT_SECRET=
# Access token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_SEC=
