NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=false

DB_HOST=193.169.241.19
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Discord OAuth — redirect must match Developer Portal exactly (scheme + host + path)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
DISCORD_SCOPES=identify
# Бот і гільдія для синхронізації ролей (ник у гільдії, verified/captain/admin у Discord)
DISCORD_BOT_TOKEN=
DISCORD_SYNC_GUILD_ID=
# Ролі в Discord (ID з сервера); якщо порожньо — відповідна синхронізація пропускається
DISCORD_VERIFIED_ROLE_ID=
DISCORD_ROLE_ID_CAPTAIN=
DISCORD_ROLE_ID_ADMIN=

# Steam OpenID — callback must be the public URL of GET /auth/steam/callback on this API (not the SPA)
STEAM_CALLBACK_URI=http://127.0.0.1:3000/auth/steam/callback
STEAM_FRONTEND_REDIRECT=http://localhost:5173/me

# App JWT (HS256). Generate: openssl rand -base64 32
JWT_SECRET=
# Access token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_SEC=

# Monobank Personal API (https://api.monobank.ua). Token is the X-Token header.
MONOBANK_TOKEN=
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_HTTP_TIMEOUT=15000
# Account whose statement/webhook is ingested and classified into finance
# operations (sponsors, prize-team payouts). See MONOBANK_ACCOUNT_IDS below to
# watch additional accounts/jars.
MONOBANK_ACCOUNT_ID=
# Monobank acquiring (ФОП) merchant token — NOT the same as MONOBANK_TOKEN
MONOBANK_MERCHANT_TOKEN=
# OPTIONAL, comma-separated. Extra account/jar ids whose full traffic is stored and
# classified into finance operations.
# Get ids from GET /bank/webhook (admin) — NOT from the send.monobank.ua/{sendId} link.
MONOBANK_ACCOUNT_IDS=

# eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI5MWFkMWY5Zi1jMzYwLTRjYzAtYjM5ZS04MWQ2NDQ0M2U5YTYiLCJpYXQiOjE3Nzc1MDIyMTIsImV4cCI6MTc3ODEwNzAxMn0.rQF5i4JJIaQ3Ze3vkCFnhCJHBzec-XG0nljetYpRwGY

# Admin analytics — live social follower counts. All optional: without keys the public
# pages / anonymous web endpoints are read (Discord, Telegram, YouTube, Twitch, TikTok work
# that way); what still fails shows the value an admin enters on the dashboard.
# Discord uses DISCORD_BOT_TOKEN + DISCORD_SYNC_GUILD_ID above, else the public invite.
# Telegram: bot must be a member of the channel; without it the public t.me page is read.
TELEGRAM_BOT_TOKEN=
# YouTube Data API v3 key (channels.list quota only)
YOUTUBE_API_KEY=
# Twitch Helix app credentials (client-credentials flow)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Instagram Graph API (business/creator account linked to a Facebook page); without it
# the anonymous instagram.com endpoints are tried, which Instagram often rate-limits.
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account id for the token above (defaults to `me`)
INSTAGRAM_USER_ID=

# ── 1v1 ladder / Dota 2 host bots (bot-worker process, src/dota-bot) ───────────
# 32 random bytes, base64 — encrypts bot Steam passwords in the host_bot table.
# Generate: npm run bot:keygen. Same value for api-v1 (admin adds bots) and bot-worker.
HOSTBOT_SECRET_KEY=
# Lobby name players see in Dota (default "Core League 1v1")
HOSTBOT_LOBBY_NAME=Core League 1v1
# Valve server_region: 3 = EU West (default)
HOSTBOT_REGION=3
# Seconds both players have to join the lobby and take a side (default 300)
HOSTBOT_JOIN_TIMEOUT=300
# Seconds a game may run before the duel is marked FAILED (default 5400)
HOSTBOT_GAME_TIMEOUT=5400
# Optional first-start seed when host_bot is empty: [{"username":"...","password":"...","region":3}]
# Accounts must have Steam Guard OFF and must have opened Dota 2 once.
# Prod: this secret. Local/self-hosted: leave empty and put the same JSON into the
# git-ignored ./hostbot-accounts.json (or point HOSTBOT_ACCOUNTS_FILE at it).
HOSTBOT_BOOTSTRAP_ACCOUNTS_JSON=
HOSTBOT_ACCOUNTS_FILE=hostbot-accounts.json
# STEAM_API_KEY above is also used for live 1v1 stats (GetRealtimeStats).
