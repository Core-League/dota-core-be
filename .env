NODE_ENV=staging
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://172.20.10.3:5173,http://127.0.0.1:5173,https://www.coreleague.online
CORS_CREDENTIALS=false

DB_USER=stage_user
DB_PASS=strong_password_here
DB_NAME=stage_db


# Discord OAuth — redirect must match Developer Portal exactly (scheme + host + path)
DISCORD_CLIENT_ID=1493729324145049710
DISCORD_CLIENT_SECRET=QEsrndAF6RIcibXPQB-9zYmDbPP-c3JC
# Must match "Redirects" in Discord Developer Portal (scheme, host, path, no extra slash mismatch)
DISCORD_REDIRECT_URI=https://www.coreleague.online
DISCORD_SCOPES=identify

# Public URL of GET /auth/steam/callback (backend), not the SPA — must be reachable for Steam’s redirect
STEAM_CALLBACK_URI=https://www.coreleague.online/auth/steam/callback
STEAM_FRONTEND_REDIRECT=https://www.coreleague.online/me

# App JWT (HS256). Generate: openssl rand -base64 32
JWT_SECRET=Z66WytcVVUzb+mHgdrG4sfcIo+C+k+YEHF2SqiqJa/A=
# Access token lifetime in seconds (default 604800 = 7 days)
JWT_EXPIRES_SEC=
